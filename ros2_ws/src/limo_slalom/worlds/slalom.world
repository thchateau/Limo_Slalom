<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="limo_slalom">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Each pair of static cylinders forms one gate. -->
    <model name="gate_1_left">
      <static>true</static><pose>-3.0 -1.25 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.07</radius><length>0.70</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.70</length></cylinder></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
    </model>
    <model name="gate_1_right">
      <static>true</static><pose>-3.0 0.25 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.07</radius><length>0.70</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.70</length></cylinder></geometry><material><ambient>0 0 1 1</ambient></material></visual></link>
    </model>
